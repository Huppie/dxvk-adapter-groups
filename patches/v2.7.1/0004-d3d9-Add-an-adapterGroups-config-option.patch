From 79e5b2fe9a3af82dc7c441a3b5f7ce4952dd0636 Mon Sep 17 00:00:00 2001
From: IJsbrand Slob <ijsbrand@mirast.com>
Date: Tue, 3 Nov 2026 17:55:33 +0100
Subject: [PATCH 4/5] [d3d9] Add an adapterGroups config option

Reports displays on the same Vulkan device as one adapter group
and maps each adapter to its own display.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 dxvk.conf                   | 12 ++++++++++++
 src/d3d9/d3d9_adapter.cpp   | 36 +++++++++++++++++++++++++++++++++++-
 src/d3d9/d3d9_adapter.h     |  6 +++++-
 src/d3d9/d3d9_interface.cpp | 36 +++++++++++++++++++++++++++++++++---
 src/d3d9/d3d9_options.cpp   |  1 +
 src/d3d9/d3d9_options.h     |  3 +++
 6 files changed, 89 insertions(+), 5 deletions(-)

diff --git a/dxvk.conf b/dxvk.conf
index 38f3db64..7137a7f2 100644
--- a/dxvk.conf
+++ b/dxvk.conf
@@ -740,6 +740,18 @@
 
 # d3d9.enumerateByDisplays = True
 
+# Adapter Groups
+#
+# Reports displays that are mapped to the same Vulkan device as one
+# adapter group, with each adapter using its own display, and allows
+# creating multi-head devices with D3DCREATE_ADAPTERGROUP_DEVICE.
+# Has no effect if d3d9.enumerateByDisplays is disabled.
+#
+# Supported values:
+# - True/False
+
+# d3d9.adapterGroups = False
+
 # Cached Dynamic Buffers
 #
 # Allocates dynamic resources in D3DPOOL_DEFAULT in
diff --git a/src/d3d9/d3d9_adapter.cpp b/src/d3d9/d3d9_adapter.cpp
index 0b61db7c..b4b92115 100644
--- a/src/d3d9/d3d9_adapter.cpp
+++ b/src/d3d9/d3d9_adapter.cpp
@@ -38,7 +38,8 @@ namespace dxvk {
     const D3D9ON12_ARGS*   p9On12Args,
           Rc<DxvkAdapter>  Adapter,
           UINT             Ordinal,
-          UINT             DisplayIndex)
+          UINT             DisplayIndex,
+    const char*            pDisplayName)
   : m_parent          (pParent),
     m_adapter         (Adapter),
     m_ordinal         (Ordinal),
@@ -51,6 +52,9 @@ namespace dxvk {
 
     if (p9On12Args)
       m_9On12Args = *p9On12Args;
+
+    if (pDisplayName)
+      m_displayName = pDisplayName;
   }
 
 
@@ -669,6 +673,16 @@ namespace dxvk {
     pCaps->AdapterOrdinalInGroup      = 0;
     // Number of adapters in current group
     pCaps->NumberOfAdaptersInGroup    = 1;
+
+    if (!m_adapterGroup.empty()) {
+      UINT ordinalInGroup = std::find(m_adapterGroup.begin(), m_adapterGroup.end(), this) - m_adapterGroup.begin();
+
+      pCaps->MasterAdapterOrdinal     = m_adapterGroup.front()->GetOrdinal();
+      pCaps->AdapterOrdinalInGroup    = ordinalInGroup;
+      // Subordinate adapters report 0
+      pCaps->NumberOfAdaptersInGroup  = ordinalInGroup ? 0 : m_adapterGroup.size();
+    }
+
     // Decl Type Caps
     pCaps->DeclTypes                  = D3DDTCAPS_UBYTE4
                                       | D3DDTCAPS_UBYTE4N
@@ -738,6 +752,26 @@ namespace dxvk {
 
 
   HMONITOR D3D9Adapter::GetMonitor() {
+    if (m_displayName.empty())
+      return wsi::getDefaultMonitor();
+
+    for (uint32_t i = 0; ; i++) {
+      HMONITOR monitor = wsi::enumMonitors(i);
+
+      if (!monitor)
+        break;
+
+      WCHAR displayName[32] = { };
+
+      if (wsi::getDisplayName(monitor, displayName) && str::fromws(displayName) == m_displayName)
+        return monitor;
+    }
+
+    static bool s_errorShown = false;
+
+    if (!std::exchange(s_errorShown, true))
+      Logger::warn(str::format("D3D9Adapter::GetMonitor: No monitor found for ", m_displayName, ", using default monitor"));
+
     return wsi::getDefaultMonitor();
   }
 
diff --git a/src/d3d9/d3d9_adapter.h b/src/d3d9/d3d9_adapter.h
index 2a658b14..1d25d77b 100644
--- a/src/d3d9/d3d9_adapter.h
+++ b/src/d3d9/d3d9_adapter.h
@@ -22,7 +22,8 @@ namespace dxvk {
       const D3D9ON12_ARGS*   p9On12Args,
             Rc<DxvkAdapter>  Adapter,
             UINT             Ordinal,
-            UINT             DisplayIndex);
+            UINT             DisplayIndex,
+      const char*            pDisplayName);
 
     HRESULT GetAdapterIdentifier(
             DWORD                   Flags,
@@ -67,6 +68,8 @@ namespace dxvk {
 
     const std::vector<D3D9Adapter*>& GetAdapterGroup() const { return m_adapterGroup; }
 
+    void SetAdapterGroup(std::vector<D3D9Adapter*>&& Group) { m_adapterGroup = std::move(Group); }
+
     UINT GetAdapterModeCountEx(const D3DDISPLAYMODEFILTER* pFilter);
 
     HRESULT EnumAdapterModesEx(
@@ -144,6 +147,7 @@ namespace dxvk {
     Rc<DxvkAdapter>               m_adapter;
     UINT                          m_ordinal;
     UINT                          m_displayIndex;
+    std::string                   m_displayName;
 
     std::vector<D3D9Adapter*>     m_adapterGroup;
 
diff --git a/src/d3d9/d3d9_interface.cpp b/src/d3d9/d3d9_interface.cpp
index 036969ad..7435d68c 100644
--- a/src/d3d9/d3d9_interface.cpp
+++ b/src/d3d9/d3d9_interface.cpp
@@ -32,9 +32,25 @@ namespace dxvk {
       DISPLAY_DEVICEA device = { };
       device.cb = sizeof(device);
 
+      uint32_t primary = 0;
+
+      // D3DADAPTER_DEFAULT must be the primary display, so enumerate it first.
+      if (m_d3d9Options.adapterGroups) {
+        while (::EnumDisplayDevicesA(nullptr, primary, &device, 0)
+            && !(device.StateFlags & DISPLAY_DEVICE_PRIMARY_DEVICE))
+          primary++;
+
+        if (!::EnumDisplayDevicesA(nullptr, primary, &device, 0))
+          primary = 0;
+      }
+
+      auto displayIndex = [primary] (uint32_t n) {
+        return n == 0 ? primary : (n <= primary ? n - 1 : n);
+      };
+
       uint32_t adapterOrdinal = 0;
       uint32_t i = 0;
-      while (::EnumDisplayDevicesA(nullptr, i++, &device, 0)) {
+      while (::EnumDisplayDevicesA(nullptr, displayIndex(i++), &device, 0)) {
         // If we aren't attached, skip over.
         if (!(device.StateFlags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP))
           continue;
@@ -49,7 +65,21 @@ namespace dxvk {
 
         if (adapter != nullptr) {
           const auto* d3d9On12Args = Find9On12Args(adapter, pOverrideList, OverrideCount);
-          m_adapters.emplace_back(this, d3d9On12Args, adapter, adapterOrdinal++, i - 1);
+          m_adapters.emplace_back(this, d3d9On12Args, adapter, adapterOrdinal++, displayIndex(i - 1),
+            m_d3d9Options.adapterGroups ? device.DeviceName : nullptr);
+        }
+      }
+
+      if (m_d3d9Options.adapterGroups) {
+        for (auto& adapter : m_adapters) {
+          std::vector<D3D9Adapter*> group;
+
+          for (auto& member : m_adapters) {
+            if (member.GetDXVKAdapter() == adapter.GetDXVKAdapter())
+              group.push_back(&member);
+          }
+
+          adapter.SetAdapterGroup(std::move(group));
         }
       }
     }
@@ -61,7 +91,7 @@ namespace dxvk {
 
       for (uint32_t i = 0; i < adapterCount; i++) {
         const auto* d3d9On12Args = Find9On12Args(m_instance->enumAdapters(i), pOverrideList, OverrideCount);
-        m_adapters.emplace_back(this, d3d9On12Args, m_instance->enumAdapters(i), i, 0);
+        m_adapters.emplace_back(this, d3d9On12Args, m_instance->enumAdapters(i), i, 0, nullptr);
       }
     }
 
diff --git a/src/d3d9/d3d9_options.cpp b/src/d3d9/d3d9_options.cpp
index 8cdcabe1..2db58d12 100644
--- a/src/d3d9/d3d9_options.cpp
+++ b/src/d3d9/d3d9_options.cpp
@@ -65,6 +65,7 @@ namespace dxvk {
     this->modeCountCompatibility        = config.getOption<bool>        ("d3d9.modeCountCompatibility",        false);
     this->allowDiscard                  = config.getOption<bool>        ("d3d9.allowDiscard",                  true);
     this->enumerateByDisplays           = config.getOption<bool>        ("d3d9.enumerateByDisplays",           true);
+    this->adapterGroups                 = config.getOption<bool>        ("d3d9.adapterGroups",                 false);
     this->cachedDynamicBuffers          = config.getOption<bool>        ("d3d9.cachedDynamicBuffers",          false);
     this->deviceLocalConstantBuffers    = config.getOption<bool>        ("d3d9.deviceLocalConstantBuffers",    false);
     this->allowDirectBufferMapping      = config.getOption<bool>        ("d3d9.allowDirectBufferMapping",      true);
diff --git a/src/d3d9/d3d9_options.h b/src/d3d9/d3d9_options.h
index 55af824c..984cebd8 100644
--- a/src/d3d9/d3d9_options.h
+++ b/src/d3d9/d3d9_options.h
@@ -125,6 +125,9 @@ namespace dxvk {
     /// Enumerate adapters by displays
     bool enumerateByDisplays;
 
+    /// Report displays on the same Vulkan device as one adapter group
+    bool adapterGroups;
+
     /// Cached dynamic buffers: Maps all buffers in cached memory.
     bool cachedDynamicBuffers;
 
-- 
2.53.0

