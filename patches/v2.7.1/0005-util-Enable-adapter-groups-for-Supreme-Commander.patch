From: IJsbrand Slob <ijsbrand@mirast.com>
Date: Tue, 3 Nov 2026 17:55:46 +0100
Subject: [PATCH 5/5] [util] Enable adapter groups for Supreme Commander

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/util/config/config.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index f6f9d6d8..0efb0e72 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -735,9 +735,11 @@ namespace dxvk {
       { "d3d9.cachedDynamicBuffers",        "True" },
       { "d3d9.countLosableResources",      "False" },
     }} },
-    /* Supreme Commander & Forged Alliance Forever */
+    /* Supreme Commander & Forged Alliance Forever *
+     * Dual screen support needs adapter groups    */
     { R"(\\(SupremeCommander|ForgedAlliance)\.exe$)", {{
       { "d3d9.floatEmulation",            "Strict" },
+      { "d3d9.adapterGroups",               "True" },
     }} },
     /* Bionic Commando                            *
      * Physics break at high fps                  */
