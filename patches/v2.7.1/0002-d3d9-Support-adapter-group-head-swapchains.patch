From abce46582de3b19bb46768bd583d0f1c46020bcb Mon Sep 17 00:00:00 2001
From: IJsbrand Slob <ijsbrand@mirast.com>
Date: Tue, 3 Nov 2026 17:55:16 +0100
Subject: [PATCH 2/5] [d3d9] Support adapter group head swapchains

Subordinate heads leave device loss, frame pacing and display modes
to head 0.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/d3d9/d3d9_device.h      |  4 ++++
 src/d3d9/d3d9_swapchain.cpp | 35 +++++++++++++++++++++++++++++++----
 src/d3d9/d3d9_swapchain.h   |  2 ++
 src/d3d9/d3d9_window.cpp    | 10 ++++++++++
 4 files changed, 47 insertions(+), 4 deletions(-)

diff --git a/src/d3d9/d3d9_device.h b/src/d3d9/d3d9_device.h
index 0e0eb037..14cabd15 100644
--- a/src/d3d9/d3d9_device.h
+++ b/src/d3d9/d3d9_device.h
@@ -1272,6 +1272,10 @@ namespace dxvk {
       return m_d3d9On12Args.Enable9On12;
     }
 
+    D3D9Adapter* GetAdapter() const {
+      return m_adapter;
+    }
+
   private:
 
     template<bool AllowFlush = true, typename Cmd>
diff --git a/src/d3d9/d3d9_swapchain.cpp b/src/d3d9/d3d9_swapchain.cpp
index 4cf494b1..058da0ad 100644
--- a/src/d3d9/d3d9_swapchain.cpp
+++ b/src/d3d9/d3d9_swapchain.cpp
@@ -634,7 +634,9 @@ namespace dxvk {
         this->LeaveFullscreenMode();
     }
     else {
-      m_parent->NotifyFullscreen(m_window, true);
+      // Device loss on focus loss only tracks head 0's window.
+      if (!IsGroupSubordinate())
+        m_parent->NotifyFullscreen(m_window, true);
 
       if (changeFullscreen) {
         hr = this->EnterFullscreenMode(pPresentParams, pFullscreenDisplayMode);
@@ -1133,6 +1135,10 @@ namespace dxvk {
         frameRate = -m_displayRefreshRate / double(SyncInterval);
     }
 
+    // Head 0 paces presentation for the whole adapter group.
+    if (IsGroupSubordinate())
+      frameRate = 0.0;
+
     m_wctx->presenter->setFrameRateLimit(frameRate, GetActualFrameLatency());
     m_targetFrameRate = frameRate;
   }
@@ -1246,7 +1252,8 @@ namespace dxvk {
         return D3DERR_INVALIDCALL;
     }
     
-    m_parent->NotifyFullscreen(m_window, true);
+    if (!IsGroupSubordinate())
+      m_parent->NotifyFullscreen(m_window, true);
     
     return D3D_OK;
   }
@@ -1268,7 +1275,8 @@ namespace dxvk {
       return D3DERR_NOTAVAILABLE;
     }
 
-    m_parent->NotifyFullscreen(m_window, false);
+    if (!IsGroupSubordinate())
+      m_parent->NotifyFullscreen(m_window, false);
     
     return D3D_OK;
   }
@@ -1294,8 +1302,19 @@ namespace dxvk {
     
     HMONITOR monitor = m_adapter->GetMonitor();
 
-    if (!wsi::setWindowMode(monitor, m_window, &m_windowState, wsiMode))
+    // Only head 0 changes and restores display modes,
+    // subordinate heads are scaled to the desktop mode.
+    if (IsGroupSubordinate()) {
+      wsi::WsiMode currentMode = { };
+
+      if (wsi::getCurrentDisplayMode(monitor, &currentMode)
+       && (currentMode.width != wsiMode.width || currentMode.height != wsiMode.height)) {
+        Logger::warn(str::format("D3D9SwapChainEx::ChangeDisplayMode: Keeping desktop mode ",
+          currentMode.width, "x", currentMode.height, " for adapter group head"));
+      }
+    } else if (!wsi::setWindowMode(monitor, m_window, &m_windowState, wsiMode)) {
       return D3DERR_NOTAVAILABLE;
+    }
 
     m_displayRefreshRate = 0.0;
 
@@ -1312,6 +1331,10 @@ namespace dxvk {
   HRESULT D3D9SwapChainEx::RestoreDisplayMode(HMONITOR hMonitor) {
     if (hMonitor == nullptr)
       return D3DERR_INVALIDCALL;
+
+    // Head 0 restores every display.
+    if (IsGroupSubordinate())
+      return D3D_OK;
     
     if (!wsi::restoreDisplayMode())
       return D3DERR_NOTAVAILABLE;
@@ -1320,6 +1343,10 @@ namespace dxvk {
     return D3D_OK;
   }
 
+  bool D3D9SwapChainEx::IsGroupSubordinate() const {
+    return m_adapter != m_parent->GetAdapter();
+  }
+
   void D3D9SwapChainEx::UpdatePresentRegion(const RECT* pSourceRect, const RECT* pDestRect) {
     const bool isWindowed = m_presentParams.Windowed;
 
diff --git a/src/d3d9/d3d9_swapchain.h b/src/d3d9/d3d9_swapchain.h
index 18e7aada..216a2711 100644
--- a/src/d3d9/d3d9_swapchain.h
+++ b/src/d3d9/d3d9_swapchain.h
@@ -133,6 +133,8 @@ namespace dxvk {
 
     D3D9Adapter* GetAdapter() const { return m_adapter; }
 
+    bool IsGroupSubordinate() const;
+
     void SyncFrameLatency();
 
     bool HasFormatsUnlocked() const { return m_unlockAdditionalFormats; }
diff --git a/src/d3d9/d3d9_window.cpp b/src/d3d9/d3d9_window.cpp
index e63391b3..7140b890 100644
--- a/src/d3d9/d3d9_window.cpp
+++ b/src/d3d9/d3d9_window.cpp
@@ -72,6 +72,16 @@ namespace dxvk
 
           wsi::getDesktopCoordinates(windowData.swapchain->GetAdapter()->GetMonitor(), &rect);
           windowData.swapchain->GetPresentParameters(&params);
+
+          // The user only activates one head's window, so restore the others here.
+          if (device->GetNumberOfSwapChains() > 1 && IsIconic(window))
+            ShowWindow(window, SW_SHOWNOACTIVATE);
+
+          // Subordinate heads keep the desktop mode, so cover their monitor.
+          if (windowData.swapchain->IsGroupSubordinate()) {
+            params.BackBufferWidth  = rect.right - rect.left;
+            params.BackBufferHeight = rect.bottom - rect.top;
+          }
           SetWindowPos(window, nullptr, rect.left, rect.top, params.BackBufferWidth, params.BackBufferHeight,
                        SWP_NOACTIVATE | SWP_NOZORDER);
         }
-- 
2.53.0

