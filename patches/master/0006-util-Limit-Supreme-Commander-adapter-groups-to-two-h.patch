From aece3745bb7c4988422c336906ffa28b965b6170 Mon Sep 17 00:00:00 2001
From: Erwin <72449986+erwingies@users.noreply.github.com>
Date: Thu, 12 Nov 2026 14:08:47 +0100
Subject: [PATCH 6/6] [util] Limit Supreme Commander adapter groups to two
 heads

The game creates its adapter group device with present parameters for
two heads. With a third display on the same GPU, device creation fails
and the game falls back to a single 1024x768 head.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/util/config/config.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/util/config/config.cpp b/src/util/config/config.cpp
index a32ef3c3..1db3fd03 100644
--- a/src/util/config/config.cpp
+++ b/src/util/config/config.cpp
@@ -778,9 +778,11 @@ namespace dxvk {
       { "d3d9.cachedWriteOnlyBuffers",      "True" },
       { "d3d9.countLosableResources",      "False" },
     }} },
-    /* Supreme Commander & Forged Alliance Forever */
+    /* Supreme Commander & Forged Alliance Forever *
+     * Dual screen mode only sets up two heads     */
     { R"(\\(SupremeCommander|ForgedAlliance)\.exe$)", {{
       { "d3d9.floatEmulation",            "Strict" },
+      { "d3d9.maxAdapterGroupHeads",           "2" },
     }} },
     /* Bionic Commando                            *
      * Physics break at high fps                  */
-- 
